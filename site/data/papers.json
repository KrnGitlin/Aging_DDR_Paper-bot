  {
    "id": "10.64898/2026.11.12.765547",
    "title": "Magnetic nanoparticle enrichment reveals conserved nitric oxide burst responses in Arabidopsis and wheat",
    "authors": [
      "Ji, R.",
      "Yang, N.",
      "Yu, L.",
      "Liu, W.",
      "Qu, M.",
      "Wang, P.",
      "Qin, G."
    ],
    "summary": "Rapid nitric oxide bursts are a conserved response to environmental stimuli, but their effects on cellular S-nitrosylation remain poorly understood. We developed a fluorinated magnetic nanoparticle method for rapid, efficient profiling of S-nitrosylation. Using Arabidopsis and wheat, we treated plant tissues with S-nitrosoglutathione (GSNO) to simulate a rapid nitric oxide surge. The method was then employed to capture S-nitrosylation dynamics within 24 h after treatment. Our analysis revealed sequence-dependent preferences for cysteines near basic or hydrophobic residues. Proteins showing rapid S-nitrosylation increases were predominantly associated with oxidative stress responses and energy metabolism, consistent with our metabolomic data. Functional studies using wheat TaGR1 mutants identified glutathione reductase 1 as a key regulated target. Modification at a conserved cysteine site rapidly modulated cellular glutathione levels in both species. Here, we provide an analytical tool and a multi-omics resource for investigating S-nitrosylation dynamics.",
    "published": "2026-11-15T00:00:00+00:00",
    "updated": null,
    "source": "bioRxiv",
    "link": "https://www.biorxiv.org/content/10.64898/2026.11.12.765547",
    "doi": "10.64898/2026.11.12.765547",
